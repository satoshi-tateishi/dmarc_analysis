# Copy to .env and set real values before `docker compose up -d`

# Container image versions
ELASTIC_VERSION=8.17.0
GRAFANA_VERSION=11.1.0
PARSEDMARC_IMAGE=xbblabs/parsedmarc:latest

# Host-side exposed ports
ELASTICSEARCH_PORT=9200
GRAFANA_PORT=3000

# Elasticsearch JVM memory limit for local Docker Desktop
# 256m で厳しい場合は 512m に戻してください
ES_JAVA_OPTS=-Xms256m -Xmx256m

# Container memory caps
ELASTICSEARCH_MEM_LIMIT=768m
ELASTICSEARCH_MEM_RESERVATION=512m
GRAFANA_MEM_LIMIT=256m
GRAFANA_MEM_RESERVATION=128m
PARSEDMARC_MEM_LIMIT=256m
PARSEDMARC_MEM_RESERVATION=128m
IMAP_CLEANUP_MEM_LIMIT=128m
IMAP_CLEANUP_MEM_RESERVATION=64m

# Grafana admin account
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Docker Desktop のメモリ割当が少なすぎると Elasticsearch が不安定になります
# まずは 4GB 前後を目安にしてください

# Generic IMAP placeholders for your DMARC mailbox
IMAP_HOST=mail.example.com
IMAP_PORT=993
IMAP_USERNAME=dmarc-reports@example.com
IMAP_PASSWORD=change-me
IMAP_USE_SSL=true
IMAP_REPORTS_FOLDER=INBOX
IMAP_ARCHIVE_FOLDER=DMARC/Archive

# IMAP cleanup policy
IMAP_CLEANUP_ENABLED=true
IMAP_CLEANUP_INTERVAL_HOURS=24
IMAP_CLEANUP_AGGREGATE_RETENTION_DAYS=30
IMAP_CLEANUP_FORENSIC_RETENTION_DAYS=30
IMAP_CLEANUP_SMTP_TLS_RETENTION_DAYS=30
IMAP_CLEANUP_INVALID_RETENTION_DAYS=90

# parsedmarc は既定で watch=False です
# 通常は必要時のみ `docker compose run --rm parsedmarc -c /etc/parsedmarc.ini` で実行します
# cleanup コンテナは IMAP 上の Archive 配下だけを定期削除します
