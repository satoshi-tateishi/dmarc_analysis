; This file is rendered from environment variables at container startup.
; Do not put secrets here. Set them in .env.
; 安全運用の前提:
; - delete = False のまま、成功メールは archive_folder 配下へ移動
; - 失敗メールは archive_folder/Invalid へ移動
; - 古いアーカイブの削除は cleanup コンテナ側で保持日数を管理

[general]
save_aggregate = True
save_forensic = False
save_smtp_tls = False
strip_attachment_payloads = True
silent = True
debug = False
offline = False

[imap]
host = ${IMAP_HOST}
port = ${IMAP_PORT}
ssl = ${IMAP_USE_SSL}
user = ${IMAP_USERNAME}
password = ${IMAP_PASSWORD}

[mailbox]
; 常時監視よりもローカル負荷を抑えるため、既定では必要時実行にしています
watch = True
; 成功/失敗にかかわらず即削除はせず、フォルダ分離で安全に管理します
delete = False
reports_folder = ${IMAP_REPORTS_FOLDER}
; 実行時に Aggregate / Forensic / SMTP-TLS / Invalid がこの配下に作成されます
archive_folder = ${IMAP_ARCHIVE_FOLDER}
batch_size = 10

[elasticsearch]
hosts = elasticsearch:9200
ssl = False
timeout = 60
number_of_shards = 1
monthly_indexes = True
